# ---- Runtime configuration (copy to .env for local use; set in the Render dashboard for deployment) ----
ARTIFACT_DIR=artifacts
# Comma-separated list of allowed browser origins (your deployed frontend URL). No wildcard by default.
CORS_ORIGINS=http://localhost:5173
# Which models must be loaded for GET /ready to return 200: image,video
REQUIRED_MODELS=image,video
MAX_IMAGE_BYTES=10485760
MAX_VIDEO_BYTES=104857600
MAX_IMAGE_PIXELS=40000000
MAX_VIDEO_SECONDS=60
EXTRACT_TIMEOUT_SECONDS=45
MAX_CONCURRENT_INFERENCES=1
QUEUE_TIMEOUT_SECONDS=20
RATE_LIMIT_PER_MINUTE=20
# Set true only when running behind a trusted proxy (Render) so X-Forwarded-For is used for rate limiting
TRUST_PROXY_HEADERS=false
TORCH_THREADS=0
# Models produced by --smoke runs are refused unless this is true (never enable in production)
ALLOW_SMOKE_MODELS=false

# ---- Optional: fetch artifacts at start-up (Render has no persistent disk on the free plan) ----
# Each URL must be https and each SHA256 is mandatory. Host the files on a private release / object store / HF repo.
IMAGE_MODEL_URL=
IMAGE_MODEL_SHA256=
IMAGE_METADATA_URL=
IMAGE_METADATA_SHA256=
VIDEO_MODEL_URL=
VIDEO_MODEL_SHA256=
VIDEO_METADATA_URL=
VIDEO_METADATA_SHA256=

# ---- Dataset download (training machine only; never commit) ----
# KAGGLE_USERNAME=
# KAGGLE_KEY=
