# ---- Runtime configuration (copy to .env for local use; set in the Render dashboard for deployment) ----
ARTIFACT_DIR=artifacts
# Comma-separated list of allowed browser origins (your deployed frontend URL). No wildcard by default.
CORS_ORIGINS=http://localhost:5173
# Which models must be loaded for GET /ready to return 200: image,video
REQUIRED_MODELS=image,video
MAX_IMAGE_BYTES=10485760
MAX_VIDEO_BYTES=104857600
MAX_IMAGE_PIXELS=40000000
MAX_VIDEO_SECONDS=60
EXTRACT_TIMEOUT_SECONDS=45
MAX_CONCURRENT_INFERENCES=1
QUEUE_TIMEOUT_SECONDS=20
RATE_LIMIT_PER_MINUTE=20
# Set true only when running behind a trusted proxy (Render) so X-Forwarded-For is used for rate limiting
TRUST_PROXY_HEADERS=false
TORCH_THREADS=0
# Models produced by --smoke runs are refused unless this is true (never enable in production)
ALLOW_SMOKE_MODELS=false

# ---- Optional: fetch artifacts at start-up (e.g. on Render with ephemeral container storage) ----
# URLs must start with https:// and each SHA256 is mandatory.
# For private Hugging Face repositories, configure HF_TOKEN (read-only token). Never commit real tokens.
HF_TOKEN=
MODEL_SAFETENSORS_URL=https://huggingface.co/YOUR_ORG/YOUR_REPO/resolve/main/model.safetensors
MODEL_SAFETENSORS_SHA256=3ec590c32f94f4297615c4d915e07d4bec4ebd4a7e0171f1e7a1b603a7f9b255
IMAGE_METADATA_URL=https://huggingface.co/YOUR_ORG/YOUR_REPO/resolve/main/image_model_metadata.json
IMAGE_METADATA_SHA256=9a5f6f7693bae9fad8f67e9436bb2a30c3bab0f42b443987f93a0d900086df02
VIDEO_METADATA_URL=https://huggingface.co/YOUR_ORG/YOUR_REPO/resolve/main/video_model_metadata.json
VIDEO_METADATA_SHA256=b17221979fc29a124b250ace950daef74d325a92641fff5e06fbe8d540952ecb

# ---- Dataset download (training machine only; never commit) ----
# KAGGLE_USERNAME=
# KAGGLE_KEY=
